.page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #edf2fb 0%, #f8fafc 100%);
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}


.card {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 34rpx 32rpx;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.07);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  overflow: hidden;
}

.card-title {
  font-size: 31rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #0f172a;
  text-align: left;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tip-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.tip-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: rgba(59, 130, 246, 0.08);
  border: 1rpx solid rgba(37, 99, 235, 0.12);
}

.tip-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tip-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
  box-shadow: 0 10rpx 16rpx rgba(37, 99, 235, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 600;
}

.tip-icon.shortcut {
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  box-shadow: 0 10rpx 16rpx rgba(34, 197, 94, 0.18);
}

.tip-icon.backup {
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  box-shadow: 0 10rpx 16rpx rgba(234, 88, 12, 0.18);
}

.tip-label {
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #0f172a;
}

.tip-desc {
  font-size: 25rpx;
  color: #475569;
  line-height: 1.68;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.step-item {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.step-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 20rpx rgba(37, 99, 235, 0.18);
}

.step-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  word-break: break-word;
}

.step-label {
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #0f172a;
}

.step-desc {
  font-size: 25rpx;
  color: #475569;
  line-height: 1.68;
  word-break: break-word;
}

.step-desc.multi {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sub-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}

.list-item {
  font-size: 25rpx;
  color: #475569;
  line-height: 1.68;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.list-item.dot {
  position: relative;
  padding-left: 6rpx;
}

.list-item.dot::before {
  content: '•';
  color: #2563eb;
  font-size: 28rpx;
  line-height: 1.4;
}

.code {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(148, 163, 184, 0.16);
  font-family: 'JetBrains Mono', 'Cascadia Code', monospace;
  font-size: 23rpx;
  color: #0f172a;
  word-break: break-all;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.faq-item {
  padding: 6rpx 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.faq-title {
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #0f172a;
}

.faq-desc {
  font-size: 23rpx;
  color: #475569;
  line-height: 1.7;
  text-indent: 3ch;
}

.info-block {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.info-paragraph {
  font-size: 25rpx;
  color: #334155;
  line-height: 1.68;
}

.info-contact {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.info-label {
  font-size: 23rpx;
  font-weight: 600;
  color: #0f172a;
  min-width: 80rpx;
}

.info-hint {
  font-size: 23rpx;
  color: #64748b;
  line-height: 1.6;
}

.code.link {
  background: rgba(37, 99, 235, 0.08);
  color: #1d4ed8;
}

.contact-link {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
}

.contact-link-btn {
  position: absolute;
  inset: 0;
  opacity: 0;
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
}

.contact-link-btn::after {
  border: none;
}

.collapsible {
  padding: 0;
  gap: 0;
}

.collapsible .card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  cursor: pointer;
  border-radius: 22rpx 22rpx 0 0;
}

.collapsible .card-body {
  padding: 0 32rpx 32rpx;
  margin-top: 0;
  border-radius: 0 0 22rpx 22rpx;
}

.card-title.center {
  text-align: center;
}

.card-header .card-title {
  margin: 0;
  text-align: left;
  font-size: 31rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #0f172a;
  flex: 1;
}


.chevron {
  width: 20rpx;
  height: 20rpx;
  border-right: 4rpx solid #4f46e5;
  border-bottom: 4rpx solid #4f46e5;
  transform: rotate(45deg);
  transition: transform 0.25s ease;
  margin-right: 4rpx;
}

.chevron.expanded {
  transform: rotate(-135deg);
}

.bullet {
  position: relative;
  font-size: 25rpx;
  color: #475569;
  line-height: 1.68;
  padding-left: 30rpx;
  word-break: break-word;
}

.bullet::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 16rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #2563eb;
}

@media (orientation: landscape) {
  .page {
    padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
    gap: 22rpx;
  }

  .card {
    padding: 30rpx 28rpx;
    gap: 20rpx;
  }

  .tip-item {
    padding: 22rpx;
  }

  .step-list {
    gap: 20rpx;
  }
}

